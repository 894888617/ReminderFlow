# =========================
# ReminderFlow Backend Env
# =========================

# 后端服务端口
SERVER_PORT=8080

# PostgreSQL 连接地址
# 本地开发示例：
DATABASE_DSN=postgres://postgres:postgres@localhost:5432/reminder_flow?sslmode=disable

# Docker Compose 示例：
# DATABASE_DSN=postgres://postgres:postgres@postgres:5432/reminder_flow?sslmode=disable

# JWT 密钥，生产环境请改成更复杂的随机字符串
JWT_SECRET=reminder-flow-secret

# =========================
# WeChat Mini Program
# =========================
WECHAT_MINI_APP_ID=your_wechat_mini_app_id
WECHAT_MINI_APP_SECRET=your_wechat_mini_app_secret

# =========================
# WeChat Mini Program Subscribe Message
# =========================

# 任务提醒模板 ID
WECHAT_MINI_TASK_REMINDER_TEMPLATE_ID=

# 任务逾期模板 ID
WECHAT_MINI_OVERDUE_TEMPLATE_ID=

# 负责人变更模板 ID
WECHAT_MINI_ASSIGNEE_TEMPLATE_ID=